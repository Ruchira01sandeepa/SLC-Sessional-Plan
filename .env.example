# Easiest: run   python -m scripts.make_env   - it writes a .env with fresh random keys.
# Or set these yourself (remove the leading # ). Never leave placeholder text as a value.
#SLC_DATABASE_URL=sqlite:///./slc_u15.db
#SLC_JWT_SECRET=<at least 32 random characters>
#SLC_MEDICAL_KEY=<output of: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
# Self sign-up ("Request access" on the sign-in screen). Requests do nothing until an administrator approves them.
#SLC_SIGNUP_ENABLED=true
#SLC_MAX_PENDING_SIGNUPS=50
